      "Parameters": {
        "iep_id.$": "$.iep_id",
        "child_id.$": "$.child_id",
        "user_id.$": "$.user_id",
        "s3_bucket.$": "$.s3_bucket",
        "s3_key.$": "$.s3_key",
        "progress": 22,
        "current_step": "cleanup_complete",
        "status": "PROCESSING"
      },
      "Next": "ParsingAgent"
    },
    "ParsingAgent": {
      "Type": "Task",
      "Resource": "${ParsingAgentArn}",
      "Comment": "Generate English summary, sections, and document index using OpenAI",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
