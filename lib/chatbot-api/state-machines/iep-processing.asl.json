      "Comment": "Name the failing step for record_failure (RedactOCR)",
      "Result": "RedactOCR",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "UpdateRedactionProgress": {
      "Type": "Task",
      "Resource": "${DDBServiceArn}",
      "Comment": "Update progress after PII redaction completion",
      "Parameters": {
        "operation": "update_progress",
        "params": {
          "iep_id.$": "$.iep_id",
          "child_id.$": "$.child_id",
          "user_id.$": "$.user_id",
          "status": "PROCESSING",
          "current_step": "pii_redaction_complete",
          "progress": 20
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailedAtUpdateRedactionProgress",
          "ResultPath": "$.error"
        }
      ],
      "Next": "SetRedactionProgress"
    },
    "FailedAtUpdateRedactionProgress": {
      "Type": "Pass",
      "Comment": "Name the failing step for record_failure (UpdateRedactionProgress)",
      "Result": "UpdateRedactionProgress",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "SetRedactionProgress": {
      "Type": "Pass",
      "Comment": "Set redaction progress values in state",
      "Parameters": {
        "iep_id.$": "$.iep_id",
        "child_id.$": "$.child_id",
        "user_id.$": "$.user_id",
        "s3_bucket.$": "$.s3_bucket",
        "s3_key.$": "$.s3_key",
        "progress": 20,
        "current_step": "pii_redaction_complete",
        "status": "PROCESSING"
      },
      "Next": "DeleteOriginal"
    },
    "DeleteOriginal": {
      "Type": "Task",
      "Resource": "${DeleteOriginalArn}",
      "Comment": "Delete original uploaded file from S3",
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
