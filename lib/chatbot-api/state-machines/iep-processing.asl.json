      "Next": "UpdateCleanupProgress"
    },
    "FailedAtDeleteOriginal": {
      "Type": "Pass",
      "Comment": "Name the failing step for record_failure (DeleteOriginal)",
      "Result": "DeleteOriginal",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "UpdateCleanupProgress": {
      "Type": "Task",
