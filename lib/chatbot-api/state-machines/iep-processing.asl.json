      "Comment": "Name the failing step for record_failure (UpdateCleanupProgress)",
      "Result": "UpdateCleanupProgress",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "SetCleanupProgress": {
      "Type": "Pass",
