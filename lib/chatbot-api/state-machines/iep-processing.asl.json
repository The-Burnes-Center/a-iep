          "Next": "FailedAtParsingAgent",
          "ResultPath": "$.error"
        }
      ],
      "Next": "UpdateAnalysisProgress",
      "ResultPath": null
    },
    "FailedAtParsingAgent": {
      "Type": "Pass",
      "Comment": "Name the failing step for record_failure (ParsingAgent)",
      "Result": "ParsingAgent",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "UpdateAnalysisProgress": {
      "Type": "Task",
      "Resource": "${DDBServiceArn}",
      "Comment": "Update progress after analysis completion",
      "Parameters": {
        "operation": "update_progress",
        "params": {
          "iep_id.$": "$.iep_id",
          "child_id.$": "$.child_id",
          "user_id.$": "$.user_id",
          "status": "PROCESSING",
          "current_step": "analysis_complete",
          "progress": 65
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailedAtUpdateAnalysisProgress",
