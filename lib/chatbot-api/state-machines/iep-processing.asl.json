{
  "Comment": "IEP Document Processing State Machine - orchestrated steps with centralized DDB service. TimeoutSeconds is declared here, in the ASL, and deliberately NOT as the CDK `timeout` prop on the StateMachine construct: with DefinitionBody.fromString, CDK silently discards that prop, so the 30 minutes this machine used to declare in functions.ts rendered no TimeoutSeconds at all (neither in the definition nor as a CloudFormation property) and the execution was in truth unbounded. A Standard execution with no timeout can linger up to the Standard maximum of one year, so a lambda that wedges rather than errors holds the document at PROCESSING and the parent on an eternal spinner for as long as it likes. 21600s (6h) is a backstop against that, not a performance budget. The slowest legitimate run is the translation branch with every task exhausting its retries: MaxAttempts 3 counts retries AFTER the initial attempt, so 4 attempts at the lambda's own timeout plus 2+4+8=14s of backoff waits per task, which sums to 12902s over the 13 tasks on that path (2414 MistralOCR + 3614 ParsingAgent + 2414 TranslateParsingResult + 1214 RedactOCR + 1214 FinalizeResults + 8 x 254 for the 60s DDB/cleanup/language tasks), or 13156s once a terminal RecordFailure is added: about 3h40m. Real runs finish in minutes, but killing an execution that would still have succeeded strands a family's document for no reason, which is the worse failure here, so the bound sits well above the worst case rather than near it. Note that an execution timeout does not run any Catch, so RecordFailure will not fire: the document stays PROCESSING and the run surfaces on the ExecutionsTimedOut metric. That is the point, and it is still strictly better than a zombie execution nobody can see.",
  "TimeoutSeconds": 21600,
  "StartAt": "InitializeProcessing",
  "States": {
    "InitializeProcessing": {
      "Type": "Task",
      "Resource": "${DDBServiceArn}",
      "Comment": "Initialize processing status and progress tracking using DDB service",
      "Parameters": {
        "operation": "update_progress",
        "params": {
          "iep_id.$": "$.iep_id",
          "child_id.$": "$.child_id",
          "user_id.$": "$.user_id",
          "status": "PROCESSING",
          "current_step": "start",
          "progress": 5
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailedAtInitializeProcessing",
          "ResultPath": "$.error"
        }
      ],
      "Next": "SetInitialProgress"
    },
    "FailedAtInitializeProcessing": {
      "Type": "Pass",
      "Comment": "Name the failing step for record_failure (InitializeProcessing)",
      "Result": "InitializeProcessing",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "SetInitialProgress": {
      "Type": "Pass",
      "Comment": "Set initial progress values in state",
      "Parameters": {
        "iep_id.$": "$.iep_id",
        "child_id.$": "$.child_id",
        "user_id.$": "$.user_id",
        "s3_bucket.$": "$.s3_bucket",
        "s3_key.$": "$.s3_key",
        "progress": 5,
        "current_step": "start",
        "status": "PROCESSING"
      },
      "Next": "MistralOCR"
    },
    "MistralOCR": {
      "Type": "Task",
      "Resource": "${MistralOCRArn}",
      "Comment": "Extract text from document using Mistral OCR API",
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailedAtMistralOCR",
          "ResultPath": "$.error"
        }
      ],
      "Next": "UpdateOCRProgress"
    },
    "FailedAtMistralOCR": {
      "Type": "Pass",
      "Comment": "Name the failing step for record_failure (MistralOCR)",
      "Result": "MistralOCR",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "UpdateOCRProgress": {
      "Type": "Task",
      "Resource": "${DDBServiceArn}",
      "Comment": "Update progress after OCR completion",
      "Parameters": {
        "operation": "update_progress",
        "params": {
          "iep_id.$": "$.iep_id",
          "child_id.$": "$.child_id",
          "user_id.$": "$.user_id",
          "status": "PROCESSING",
          "current_step": "ocr_complete",
          "progress": 15
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailedAtUpdateOCRProgress",
          "ResultPath": "$.error"
        }
      ],
      "Next": "SetOCRProgress"
    },
    "FailedAtUpdateOCRProgress": {
      "Type": "Pass",
      "Comment": "Name the failing step for record_failure (UpdateOCRProgress)",
      "Result": "UpdateOCRProgress",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "SetOCRProgress": {
      "Type": "Pass",
      "Comment": "Set OCR progress values in state",
      "Parameters": {
        "iep_id.$": "$.iep_id",
        "child_id.$": "$.child_id",
        "user_id.$": "$.user_id",
        "s3_bucket.$": "$.s3_bucket",
        "s3_key.$": "$.s3_key",
        "progress": 15,
        "current_step": "ocr_complete",
        "status": "PROCESSING"
      },
      "Next": "RedactOCR"
    },
    "RedactOCR": {
      "Type": "Task",
      "Resource": "${RedactOCRArn}",
      "Comment": "Redact PII from OCR text using AWS Comprehend",
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailedAtRedactOCR",
          "ResultPath": "$.error"
