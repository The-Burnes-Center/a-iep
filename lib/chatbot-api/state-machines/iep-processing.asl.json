      "Next": "CheckLanguagePrefs"
    },
    "CheckLanguagePrefs": {
      "Type": "Task",
      "Resource": "${CheckLanguagePrefsArn}",
      "Comment": "Check user language preferences to determine if translations are needed",
      "Parameters": {
        "iep_id.$": "$.iep_id",
        "child_id.$": "$.child_id",
        "user_id.$": "$.user_id",
        "s3_bucket.$": "$.s3_bucket",
        "s3_key.$": "$.s3_key",
        "progress.$": "$.progress",
        "current_step.$": "$.current_step",
        "status.$": "$.status"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "FailedAtCheckLanguagePrefs",
          "ResultPath": "$.error"
        }
      ],
      "Next": "TranslationChoice"
    },
    "FailedAtCheckLanguagePrefs": {
      "Type": "Pass",
      "Comment": "Name the failing step for record_failure (CheckLanguagePrefs)",
      "Result": "CheckLanguagePrefs",
      "ResultPath": "$.failed_step",
      "Next": "RecordFailure"
    },
    "TranslationChoice": {
      "Type": "Choice",
      "Comment": "Decide whether to translate based on user language preferences",
      "Choices": [
