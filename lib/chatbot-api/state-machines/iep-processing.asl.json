        "child_id.$": "$.child_id",
        "user_id.$": "$.user_id",
        "s3_bucket.$": "$.s3_bucket",
        "s3_key.$": "$.s3_key",
        "progress": 65,
        "current_step": "analysis_complete",
        "status": "PROCESSING"
